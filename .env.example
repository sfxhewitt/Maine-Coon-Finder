# Copy to .env and fill in. Never commit .env.

# --- Telegram (required) ---
# From @BotFather. Then message your bot once and run the finder: it replies with your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude photo check (required) --- https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Email to sellers (needed for the Yes button to send email) ---
# Gmail: turn on 2-step verification, then make an app password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# EMAIL_FROM defaults to SMTP_USER
# EMAIL_BCC_SELF=true

# --- You (signed at the bottom of the message) ---
BUYER_NAME=
BUYER_PHONE=
BUYER_LOCATION=

# --- Search rules ---
MAX_PRICE_GBP=1000
PREFERRED_PRICE_GBP=500
MAX_AGE_DAYS=365
# Leave blank to search the whole UK.
HOME_POSTCODE=
MAX_DISTANCE_MILES=
ALLOW_CROSSBREEDS=false
# ACCEPTED_COLOURS=solid blue,blue smoke,black smoke,dark grey,charcoal
# MIN_COLOUR_CONFIDENCE=0.6
SOURCES=pets4homes,gumtree,preloved

# --- Timing ---
SCAN_INTERVAL_SECONDS=180
REQUEST_DELAY_SECONDS=2
BACKFILL_PAGES=3

# DRY_RUN=true   # log emails instead of sending them

# --- Pets4Homes chat as you (optional) ---
# Pets4Homes hides seller emails; with this on, Yes sends your message in Pets4Homes
# chat from your own account. Against Pets4Homes' terms: your account could be suspended.
# P4H_AUTO_MESSAGE=true
# Log in once with `python -m maine_coon_finder p4h-login` on your computer, or set
# P4H_EMAIL (and P4H_PASSWORD if you use one) and the bot asks for the emailed code on Telegram.
# P4H_EMAIL=
# P4H_PASSWORD=
# P4H_SESSION_B64=   # output of p4h-login, for servers

# --- Preloved replies as you (optional, same caveats) ---
# PRELOVED_AUTO_MESSAGE=true
# PRELOVED_EMAIL=
# PRELOVED_PASSWORD=
